{
  "runner": "scripts/run-validation-check.mjs",
  "implementations": {
    "check-font": "scripts/check-font.sh",
    "check-layout-constraints": "scripts/check-layout-constraints.mjs",
    "check-information-value": "scripts/check-information-value.mjs",
    "capture-review-snapshots": "scripts/run-validation-check.mjs",
    "audio-silence-check": "scripts/run-validation-check.mjs",
    "hyperframes-check": "scripts/run-validation-check.mjs",
    "check-captions": "scripts/check-captions.mjs",
    "ffprobe": "scripts/run-validation-check.mjs"
  },
  "visual": {
    "typography": {
      "kind": "validator-report",
      "validator": "check-font",
      "directory": "logs",
      "subject": "source"
    },
    "layout-and-safe-regions": {
      "kind": "validator-report",
      "validator": "check-layout-constraints",
      "directory": "logs",
      "subject": "source",
      "repositoryInputs": ["schemas/beat-map.schema.json"]
    },
    "information-value": {
      "kind": "validator-report",
      "validator": "check-information-value",
      "directory": "logs",
      "subject": "source"
    },
    "snapshots": {
      "kind": "snapshot-manifest",
      "validator": "capture-review-snapshots",
      "directory": "checkpoints",
      "subject": "sample"
    },
    "audio": {
      "kind": "audio-analysis",
      "validator": "audio-silence-check",
      "directory": "logs",
      "subject": "sample"
    }
  },
  "final": {
    "hyperframes": {
      "kind": "validator-report",
      "validator": "hyperframes-check",
      "directory": "logs",
      "subject": "composition"
    },
    "font": {
      "kind": "validator-report",
      "validator": "check-font",
      "directory": "logs",
      "subject": "composition"
    },
    "information-value": {
      "kind": "validator-report",
      "validator": "check-information-value",
      "directory": "logs",
      "subject": "composition"
    },
    "layout": {
      "kind": "validator-report",
      "validator": "check-layout-constraints",
      "directory": "logs",
      "subject": "composition",
      "repositoryInputs": ["schemas/beat-map.schema.json"]
    },
    "snapshots": {
      "kind": "snapshot-manifest",
      "validator": "capture-review-snapshots",
      "directory": "checkpoints",
      "subject": "preview"
    },
    "captions": {
      "kind": "validator-report",
      "validator": "check-captions",
      "directory": "logs",
      "subject": "composition"
    },
    "audio": {
      "kind": "audio-analysis",
      "validator": "audio-silence-check",
      "directory": "logs",
      "subject": "preview"
    },
    "media": {
      "kind": "media-probe",
      "validator": "ffprobe",
      "directory": "logs",
      "subject": "preview"
    }
  }
}
