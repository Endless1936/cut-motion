{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cut-motion ChatCut Rough Cut Record",
  "type": "object",
  "required": ["schemaVersion", "source", "projectId", "timelineIds", "recordedAt"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "source": { "const": "chatcut" },
    "projectId": { "type": "string", "minLength": 1 },
    "timelineIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "activeTimelineId": { "type": ["string", "null"] },
    "timelines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "recordedAt": { "type": "string", "minLength": 1 },
    "note": { "type": "string" }
  },
  "additionalProperties": false
}
