{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cut-motion ChatCut Rough Cut Record",
  "type": "object",
  "required": ["schemaVersion", "source", "projectId", "timelineIds", "recordedAt"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "source": { "const": "chatcut" },
    "projectId": { "type": "string", "minLength": 1 },
    "timelineIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "sourceAssetId": { "type": "string", "minLength": 1 },
    "sourceAssetName": { "type": "string", "minLength": 1 },
    "sourceDurationSeconds": { "type": "number", "exclusiveMinimum": 0 },
    "roughCutDurationSeconds": { "type": "number", "exclusiveMinimum": 0 },
    "referenceDurationSeconds": { "type": "number", "exclusiveMinimum": 0 },
    "elapsedSecondsByStage": {
      "type": "object",
      "properties": {
        "projectAndAssetLookup": { "type": "number", "minimum": 0 },
        "assetTransfer": { "type": "number", "minimum": 0 },
        "transcription": { "type": "number", "minimum": 0 },
        "semanticCut": { "type": "number", "minimum": 0 },
        "wholeTimelineSweep": { "type": "number", "minimum": 0 },
        "sourceWaveformIndex": { "type": "number", "minimum": 0 },
        "batchSeamLookup": { "type": "number", "minimum": 0 },
        "seamAdjustment": { "type": "number", "minimum": 0 },
        "total": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "activeTimelineId": { "type": ["string", "null"] },
    "timelines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "recordedAt": { "type": "string", "minLength": 1 },
    "note": { "type": "string" }
  },
  "additionalProperties": false
}
