{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cut-motion ChatCut source-word timeline mapping",
  "type": "object",
  "required": ["schemaVersion", "fps", "entries"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "fps": { "type": "number", "exclusiveMinimum": 0 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sourceStartMs", "sourceEndMs", "timelineStartFrame", "timelineEndFrame"],
        "properties": {
          "sourceStartMs": { "type": "number", "minimum": 0 },
          "sourceEndMs": { "type": "number", "exclusiveMinimum": 0 },
          "timelineStartFrame": { "type": "integer", "minimum": 0 },
          "timelineEndFrame": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
