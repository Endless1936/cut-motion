{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cut-motion Caption Review Plan",
  "type": "object",
  "required": ["schemaVersion", "status", "wordingAuthority", "transcriptRevision", "transcriptSha256", "timingAuthority", "segmentationAuthority", "rules", "exceptions", "cues"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "status": { "enum": ["proposed", "approved"] },
    "wordingAuthority": { "const": "state/transcript.json" },
    "transcriptRevision": { "type": "integer", "minimum": 1 },
    "transcriptSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timingAuthority": { "enum": ["state/transcript.json word ranges", "approved ChatCut main timeline item ranges", "agent-authored cue ranges within transcript segment ranges", "agent-authored cue ranges within approved ChatCut main timeline item ranges"] },
    "segmentationAuthority": { "enum": ["ChatCut source segment boundaries", "agent-authored word ranges", "ChatCut main timeline transcript entries", "agent-authored phrase cues within transcript segments", "agent-authored phrase cues within ChatCut main timeline entries"] },
    "rules": { "type": "object" },
    "exceptions": { "type": "object" },
    "cues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string", "pattern": "^caption-[0-9]{4}$" },
          "text": { "type": "string", "minLength": 1 },
          "segmentId": { "type": "string", "minLength": 1 },
          "start": { "type": "number", "minimum": 0 },
          "end": { "type": "number", "exclusiveMinimum": 0 },
          "startWordId": { "type": "string", "pattern": "^.+:word-[0-9]{3}$" },
          "endWordId": { "type": "string", "pattern": "^.+:word-[0-9]{3}$" },
          "fitFontSizePx": { "type": "number", "minimum": 1 }
        },
        "oneOf": [
          {
            "required": ["startWordId", "endWordId"],
            "not": { "anyOf": [{ "required": ["segmentId"] }, { "required": ["start"] }, { "required": ["end"] }] }
          },
          {
            "required": ["segmentId", "start", "end"],
            "not": { "anyOf": [{ "required": ["startWordId"] }, { "required": ["endWordId"] }] }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
