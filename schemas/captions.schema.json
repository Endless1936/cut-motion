{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cut-motion Captions",
  "type": "object",
  "required": ["source", "style", "cues"],
  "properties": {
    "source": {
      "type": "object",
      "required": ["kind", "fps", "cleanExport", "roughCutLocked"],
      "properties": {
        "kind": { "const": "approved-semantic-plan" },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "cleanExport": { "oneOf": [{ "const": true }, { "type": "string", "pattern": "\\S" }] },
        "timelineVersion": { "type": ["string", "null"] },
        "roughCutLocked": { "const": true },
        "captionRenderDisabled": { "type": "boolean" }
      }
    },
    "style": {
      "type": "object",
      "required": ["fontFamily", "color", "fontSizePx", "minimumFontSizePx", "lineHeight", "maximumDisplayUnits", "maximumLines", "bottomOffsetRatio", "bottomOffsetPx", "opaqueBackground", "shadow"],
      "properties": {
        "fontFamily": { "const": "Smiley Sans" },
        "fontWeight": { "const": 400 },
        "color": { "const": "#FFFFFF" },
        "fontSizePx": { "type": "number", "minimum": 42 },
        "lineHeight": { "type": "number", "minimum": 1, "maximum": 1.35 },
        "minimumFontSizePx": { "type": "number", "minimum": 42 },
        "maximumDisplayUnits": { "type": "number" },
        "maximumLines": { "const": 1 },
        "bottomOffsetRatio": { "type": "number", "minimum": 0.1, "maximum": 0.35 },
        "bottomOffsetPx": { "type": "number", "minimum": 100 },
        "opaqueBackground": { "const": false },
        "shadow": {
          "type": "object",
          "required": ["xPx", "yPx", "blurPx", "color"],
          "properties": {
            "xPx": { "type": "number" },
            "yPx": { "type": "number", "minimum": 1 },
            "blurPx": { "type": "number", "minimum": 1 },
            "color": { "type": "string" }
          }
        }
      }
    },
    "cues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "sourcePageId", "startFrame", "endFrame", "start", "end", "viewerText", "lines"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "sourcePageId": { "type": "string", "minLength": 1 },
          "startFrame": { "type": "integer", "minimum": 0 },
          "endFrame": { "type": "integer", "minimum": 1 },
          "start": { "type": "number", "minimum": 0 },
          "end": { "type": "number", "minimum": 0 },
          "viewerText": { "type": "string", "pattern": "\\S" },
          "lines": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "type": "string", "pattern": "^(?![\\s\\S]*[\\r\\n])(?=[\\s\\S]*\\S)[\\s\\S]+$" } }
        }
      }
    }
  }
}
