{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cut-motion ChatCut Caption Pages",
  "type": "object",
  "required": ["source", "fps", "cleanExport", "roughCutLocked"],
  "properties": {
    "source": { "enum": ["chatcut-viewer-pages", "ChatCut inspect_asset original source word rows"] },
    "fps": { "type": "number", "exclusiveMinimum": 0 },
    "cleanExport": { "oneOf": [{ "const": true }, { "type": "string", "pattern": "\\S" }] },
    "timelineVersion": { "type": ["string", "null"] },
    "roughCutLocked": { "const": true },
    "captionRenderDisabled": { "type": "boolean" },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["startMs", "endMs"],
        "properties": {
          "startMs": { "type": "number", "minimum": 0 },
          "endMs": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "timelineMapping": { "type": "string", "minLength": 1 },
    "timelineMappingSha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "oneOf": [
          {
            "required": ["id", "startFrame", "endFrame", "viewerText"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "startFrame": { "type": "integer", "minimum": 0 },
              "endFrame": { "type": "integer", "minimum": 1 },
              "viewerText": { "type": "string", "pattern": "\\S" }
            }
          },
          {
            "required": ["id", "start", "end", "text"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 },
              "text": { "type": "string", "pattern": "\\S" }
            }
          }
        ]
      }
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "startFrame", "endFrame", "text"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "startFrame": { "type": "integer", "minimum": 0 },
          "endFrame": { "type": "integer", "minimum": 1 },
          "text": { "type": "string", "pattern": "\\S" },
          "wordCount": { "type": "integer", "minimum": 0 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "source": { "const": "chatcut-viewer-pages" } }, "required": ["source"] },
      "then": { "anyOf": [{ "required": ["pages"] }, { "required": ["cards"] }] }
    },
    {
      "if": { "properties": { "source": { "const": "ChatCut inspect_asset original source word rows" } }, "required": ["source"] },
      "then": { "required": ["rows", "timelineMapping", "timelineMappingSha256"] }
    }
  ]
}
