{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cut-motion Creative Confirmation",
  "type": "object",
  "required": ["schemaVersion", "captionMode", "captionModeDecision", "visualAxisMode", "visualAxisModeDecision", "storyboard", "scriptAnnotations", "authorities", "changeControl", "axisPolicy", "review"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "captionMode": { "enum": ["motion-copy", "subtitles"] },
    "captionModeDecision": {
      "type": "object",
      "required": ["status", "source"],
      "properties": {
        "status": { "enum": ["default-proposed", "acknowledged"] },
        "source": { "enum": ["default", "user", "auto"] }
      },
      "additionalProperties": false
    },
    "visualAxisMode": { "enum": ["a-axis-overlay", "b-axis-stage", "hybrid"] },
    "visualAxisModeDecision": {
      "type": "object",
      "required": ["status", "source"],
      "properties": {
        "status": { "enum": ["default-proposed", "acknowledged"] },
        "source": { "enum": ["default", "user", "auto"] }
      },
      "additionalProperties": false
    },
    "storyboard": {
      "type": "object",
      "required": ["motionPlan", "beatMap", "beatCount"],
      "properties": {
        "motionPlan": { "const": "docs/motion-plan.md" },
        "captionPlan": { "const": "docs/caption-plan.md" },
        "beatMap": { "const": "state/beat-map.json" },
        "beatCount": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "scriptAnnotations": {
      "type": "object",
      "required": ["source", "role", "exhaustiveVisualPlan", "decisions"],
      "properties": {
        "source": { "const": "state/reference-script-annotations.json" },
        "role": { "const": "advisory" },
        "exhaustiveVisualPlan": { "const": false },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "resolvedScope", "disposition", "finalTreatment", "reason", "beatIds"],
            "properties": {
              "id": { "type": "string", "pattern": "^annotation-[0-9]{3,}$" },
              "resolvedScope": { "type": "string", "minLength": 1 },
              "disposition": { "enum": ["adopted", "adjusted", "rejected"] },
              "finalTreatment": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 },
              "beatIds": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "authorities": {
      "type": "object",
      "properties": {
        "transcript": { "$ref": "#/$defs/authority" },
        "captionPlan": { "$ref": "#/$defs/authority" },
        "beatMap": { "$ref": "#/$defs/authority" }
      },
      "additionalProperties": false
    },
    "changeControl": {
      "type": "object",
      "required": ["implementationMayStartAfter", "planChangesRequireReapproval", "reapprovalFields"],
      "properties": {
        "implementationMayStartAfter": { "const": "creative-package-approved" },
        "planChangesRequireReapproval": { "const": true },
        "reapprovalFields": {
          "type": "array",
          "minItems": 9,
          "uniqueItems": true,
          "items": {
            "enum": ["caption-segmentation", "mg-node-set", "mg-count", "on-screen-copy", "support-role", "visual-style", "primary-flow-axis", "visual-reference", "axis-mode"]
          }
        }
      },
      "additionalProperties": false
    },
    "axisPolicy": {
      "type": "object",
      "required": ["A", "B"],
      "properties": {
        "A": {
          "type": "object",
          "required": ["accumulation", "overlayZones", "faceProtection", "surface"],
          "properties": {
            "accumulation": { "const": "replace" },
            "overlayZones": { "type": "array", "minItems": 1, "items": { "enum": ["top", "bottom", "side"] } },
            "faceProtection": { "enum": ["brief-semantic-only", "required"] },
            "surface": {
              "type": "object",
              "required": ["kind", "fullFrame", "opacityRange", "backdropBlurPx"],
              "properties": {
                "kind": { "const": "localized-glass" },
                "fullFrame": { "const": false },
                "opacityRange": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": { "type": "number", "minimum": 0, "maximum": 1 }
                },
                "backdropBlurPx": { "type": "number", "minimum": 0, "maximum": 18 }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "B": {
          "type": "object",
          "required": ["accumulation", "groupedExit", "pip"],
          "properties": {
            "accumulation": { "const": "accumulate" },
            "groupedExit": { "const": true },
            "pip": {
              "type": "object",
              "required": ["live", "protected", "exclusionZone"],
              "properties": {
                "live": { "const": true },
                "protected": { "const": true },
                "exclusionZone": {
                  "type": "object",
                  "required": ["rightPx", "bottomPx", "widthPx", "heightPx"],
                  "properties": {
                    "rightPx": { "type": "number", "exclusiveMinimum": 0 },
                    "bottomPx": { "type": "number", "exclusiveMinimum": 0 },
                    "widthPx": { "type": "number", "exclusiveMinimum": 0 },
                    "heightPx": { "type": "number", "exclusiveMinimum": 0 }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "required": { "type": "boolean" },
        "status": { "enum": ["draft", "ready", "approved", "revision-requested"] },
        "actor": { "type": "string" },
        "decidedAt": { "type": "string" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "authority": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
