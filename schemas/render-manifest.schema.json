{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cut-motion Render Manifest",
  "type": "object",
  "required": ["schemaVersion", "fps", "width", "height", "totalFrames", "duration", "audio", "designLanguageFingerprint", "sharedDependencySha256", "beats", "captions", "contentManifestSha256", "chunks"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "fps": { "type": "number", "exclusiveMinimum": 0 },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "totalFrames": { "type": "integer", "minimum": 1 },
    "duration": { "type": "number", "exclusiveMinimum": 0 },
    "audio": {
      "type": "object",
      "required": ["sourcePath", "sourceSha256"],
      "properties": {
        "sourcePath": { "type": "string", "minLength": 1 },
        "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "designLanguageFingerprint": { "type": "string", "minLength": 1 },
    "sharedDependencySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "beats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["beatId", "modulePath", "rootSelector", "captionCueIds", "window", "fingerprint"],
        "properties": {
          "beatId": { "type": "string", "minLength": 1 },
          "modulePath": { "type": ["string", "null"] },
          "rootSelector": { "type": ["string", "null"] },
          "captionCueIds": { "type": "array", "items": { "type": "string" } },
          "window": { "$ref": "#/$defs/frameWindow" },
          "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cueId", "window", "fingerprint"],
        "properties": {
          "cueId": { "type": "string", "minLength": 1 },
          "window": { "$ref": "#/$defs/frameWindow" },
          "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "contentManifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "startFrame", "endFrame", "beatIds", "captionCueIds", "dependencySha256", "cacheKey"],
        "properties": {
          "id": { "type": "string", "pattern": "^f[0-9]+-f[0-9]+$" },
          "startFrame": { "type": "integer", "minimum": 0 },
          "endFrame": { "type": "integer", "minimum": 1 },
          "beatIds": { "type": "array", "items": { "type": "string" } },
          "captionCueIds": { "type": "array", "items": { "type": "string" } },
          "dependencySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "cacheKey": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "frameWindow": {
      "type": "object",
      "required": ["startFrame", "endFrame"],
      "properties": {
        "startFrame": { "type": "integer", "minimum": 0 },
        "endFrame": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
