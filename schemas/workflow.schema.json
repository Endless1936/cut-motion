{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://motionscript.dev/schemas/workflow.schema.json",
  "title": "MotionScript Workflow State",
  "type": "object",
  "required": ["schemaVersion", "jobId", "mode", "captionMode", "captionModeSource", "captionModeAcknowledged", "visualAxisMode", "visualAxisModeSource", "visualAxisModeAcknowledged", "referenceScriptStatus", "referenceScriptAcknowledged", "referenceScriptPath", "referenceScriptSha256", "intakeDecisionBlock", "reconciliationReturnState", "creativeConfirmationSha256", "pendingCreativePackageSha256", "creativeDocumentFingerprints", "authoritativeMediaPath", "authoritativeMediaSha256", "trimPlanSha256", "visualPlanSha256", "compositionArtifactPath", "compositionArtifactSha256", "revisionId", "approvedVisualSampleFingerprint", "currentState", "pendingGate", "completed", "gates", "history"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "jobId": { "type": "string" },
    "mode": { "enum": ["review", "auto"] },
    "captionMode": { "enum": ["motion-copy", "subtitles"] },
    "captionModeSource": { "enum": ["default", "user", "auto"] },
    "captionModeAcknowledged": { "type": "boolean" },
    "visualAxisMode": { "enum": ["a-axis-overlay", "b-axis-stage", "hybrid"] },
    "visualAxisModeSource": { "enum": ["default", "user", "auto"] },
    "visualAxisModeAcknowledged": { "type": "boolean" },
    "referenceScriptStatus": { "enum": ["unknown", "none", "provided"] },
    "referenceScriptAcknowledged": { "type": "boolean" },
    "referenceScriptPath": { "type": ["string", "null"] },
    "referenceScriptSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "intakeDecisionBlock": { "type": "boolean" },
    "reconciliationReturnState": { "enum": [null, "rough-cut", "motion-plan"] },
    "creativeConfirmationSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "pendingCreativePackageSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "creativeDocumentFingerprints": { "type": ["object", "null"] },
    "authoritativeMediaPath": { "type": ["string", "null"] },
    "authoritativeMediaSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "trimPlanSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "visualPlanSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "compositionArtifactPath": { "type": ["string", "null"] },
    "compositionArtifactSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "revisionId": { "type": "integer", "minimum": 1 },
    "approvedVisualSampleFingerprint": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "currentState": {
      "enum": ["intake", "transcription", "rough-cut", "rough-cut-review", "motion-plan", "motion-plan-review", "visual-sample", "visual-sample-review", "composition", "qa", "final-preview", "render", "complete"]
    },
    "pendingGate": { "type": ["string", "null"] },
    "completed": { "type": "boolean" },
    "createdAt": { "type": ["string", "null"] },
    "updatedAt": { "type": ["string", "null"] },
    "gates": { "type": "object" },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at", "action", "actor", "from", "to"],
        "properties": {
          "at": { "type": "string" },
          "action": { "type": "string" },
          "actor": { "type": "string" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "artifact": { "type": ["string", "null"] },
          "note": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
