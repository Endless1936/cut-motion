{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cut-motion Beat Map",
  "type": "object",
  "required": ["duration", "fps", "captionMode", "designSystem", "beats"],
  "properties": {
    "duration": { "type": "number", "minimum": 0 },
    "fps": { "type": "number", "exclusiveMinimum": 0 },
    "captionMode": { "enum": ["motion-copy", "subtitles"] },
    "designSystem": { "type": "string", "minLength": 1 },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "sceneId", "sourceSegmentIds", "text", "start", "end", "audioAnchorTime", "axis", "recipe", "intent", "motionFamily", "transitionFamily"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "sceneId": { "type": "string" },
          "sourceSegmentIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "text": { "type": "string", "minLength": 1 },
          "start": { "type": "number", "minimum": 0 },
          "end": { "type": "number", "minimum": 0 },
          "audioAnchorTime": { "type": "number", "minimum": 0 },
          "axis": { "enum": ["A", "B"] },
          "recipe": { "type": "string" },
          "mgScope": { "enum": ["none", "local"] },
          "captionSafeZonePass": { "type": "boolean" },
          "intent": { "type": "string" },
          "onScreenCopy": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": { "type": "string", "minLength": 1 }
          },
          "captionCueIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^caption-[0-9]{4}$" }
          },
          "visualStyle": { "type": "string", "minLength": 1 },
          "primaryFlowAxis": { "enum": ["horizontal", "vertical"] },
          "visualReference": { "type": "string", "minLength": 1 },
          "semanticTopology": { "enum": ["sequence", "comparison", "convergence", "branch", "mapping", "emphasis", "evidence"] },
          "entryAnchorWordId": { "type": "string", "pattern": "^.+:word-[0-9]{3}$" },
          "exitAnchorWordId": { "type": "string", "pattern": "^.+:word-[0-9]{3}$" },
          "exitAnchorOffsetFrames": { "type": "integer", "minimum": 0, "maximum": 12 },
          "reuseGroup": { "type": "string", "minLength": 1 },
          "reuseReason": { "type": "string", "minLength": 1 },
          "viewerQuestion": { "type": "string", "minLength": 1 },
          "supportRole": { "enum": ["evidence", "explanation", "calibration", "organization", "action", "consequence"] },
          "removalLoss": { "type": "string", "minLength": 1 },
          "visualEncoding": { "type": "string", "minLength": 1 },
          "stillFrameValue": { "type": "string", "minLength": 1 },
          "attentionCost": { "enum": ["low", "medium", "high"] },
          "attentionCostReason": { "type": "string", "minLength": 1 },
          "evidenceSource": { "type": "string", "minLength": 1 },
          "factualClaims": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["claim", "source"],
              "properties": {
                "claim": { "type": "string", "minLength": 1 },
                "source": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          },
          "terms": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["term", "plainExplanation"],
              "properties": {
                "term": { "type": "string", "minLength": 1 },
                "plainExplanation": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          },
          "motionFamily": { "enum": ["editorial", "technical", "celebration", "hybrid"] },
          "transitionFamily": { "type": "string", "minLength": 1 },
          "microEvents": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "object",
              "required": ["time", "type", "semanticChange"],
              "properties": {
                "time": { "type": "number", "minimum": 0 },
                "type": { "type": "string" },
                "semanticChange": { "type": "string", "minLength": 1 },
                "revealGroup": { "type": "string", "minLength": 1 },
                "visualRole": { "enum": ["connector", "container", "copy", "icon", "indicator"] },
                "topologyRole": { "enum": ["node", "source", "input", "branch", "result", "comparison-a", "comparison-b"] }
              }
            }
          },
          "layout": {
            "type": "object",
            "required": ["primaryOccupancyRatio", "primaryBoundsNormalized", "supportingElementCount", "emptyComponentCount", "panelPaddingPx", "safeAreaPass", "faceCover"],
            "properties": {
              "primaryOccupancyRatio": { "type": "number", "minimum": 0, "maximum": 1 },
              "primaryBoundsNormalized": {
                "type": "object",
                "required": ["x", "y", "width", "height"],
                "properties": {
                  "x": { "type": "number", "minimum": 0, "maximum": 1 },
                  "y": { "type": "number", "minimum": 0, "maximum": 1 },
                  "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
                  "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
                },
                "additionalProperties": false
              },
              "supportingElementCount": { "type": "integer", "minimum": 0, "maximum": 4 },
              "emptyComponentCount": { "const": 0 },
              "panelPaddingPx": { "type": "number", "minimum": 0 },
              "safeAreaPass": { "const": true },
              "faceCover": { "enum": ["none", "partial", "intentional"] },
              "faceCoverApproval": { "const": "user" },
              "faceSafetyNote": { "type": "string", "minLength": 1 }
            }
          },
          "typography": {
            "type": "object",
            "required": ["fontFamily", "role", "fontSizePx", "lineHeight", "maxLines", "outlineReservePx"],
            "properties": {
              "fontFamily": { "const": "Smiley Sans" },
              "fontWeight": { "const": 400 },
              "role": { "enum": ["primary", "secondary"] },
              "fontSizePx": { "type": "number", "exclusiveMinimum": 0 },
              "lineHeight": { "type": "number", "exclusiveMinimum": 0 },
              "maxLines": { "type": "integer", "minimum": 1, "maximum": 4 },
              "outlineReservePx": { "type": "number", "minimum": 0 }
            }
          },
          "components": { "type": "array", "minItems": 0, "maxItems": 4, "items": { "type": "string", "minLength": 1 } },
          "entranceFrames": { "type": "integer", "minimum": 1 },
          "exitFrames": { "type": "integer", "minimum": 1 },
          "staticHoldReason": { "type": "string" },
          "syncException": { "type": "string" },
          "majorSceneException": { "type": "string" },
          "axisException": { "type": "string" },
          "copyException": { "type": "string" },
          "reuseSource": { "type": "boolean" },
          "notes": { "type": "string" }
        },
        "allOf": [
          {
            "if": { "properties": { "recipe": { "const": "caption-only" } }, "required": ["recipe"] },
            "else": { "required": ["primaryFlowAxis", "visualReference", "semanticTopology", "entryAnchorWordId", "exitAnchorWordId", "exitAnchorOffsetFrames", "exitFrames"] }
          }
        ]
      }
    }
  }
}
