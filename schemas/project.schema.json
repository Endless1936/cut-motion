{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cut-motion Project",
  "type": "object",
  "required": ["schemaVersion", "id", "sourceVideo", "language", "width", "height", "fps", "designSystem"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "sourceVideo": { "type": "string", "minLength": 1 },
    "transcript": { "type": ["string", "null"] },
    "language": { "type": "string", "default": "zh-CN" },
    "width": { "type": "integer", "minimum": 240 },
    "height": { "type": "integer", "minimum": 240 },
    "fps": { "type": "number", "exclusiveMinimum": 0 },
    "roughCutEngine": { "enum": ["chatcut", "ffmpeg-fallback"] },
    "designSystem": { "type": "string", "minLength": 1 },
    "silence": {
      "type": "object",
      "required": ["noiseDb", "minimumSeconds", "edgePaddingSeconds"],
      "properties": {
        "noiseDb": { "type": "number", "maximum": 0 },
        "minimumSeconds": { "type": "number", "minimum": 0.2 },
        "edgePaddingSeconds": { "type": "number", "minimum": 0.03, "maximum": 0.2 }
      },
      "additionalProperties": false
    },
    "deviations": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "mediaArtifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["path", "sha256", "duration", "updatedAt"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "duration": { "type": "number", "exclusiveMinimum": 0 },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "fps": { "type": "string" },
          "updatedAt": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "additionalProperties": false
}
