{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cut-motion.local/schemas/trim-plan.schema.json",
  "title": "cut-motion Trim Decisions",
  "description": "Schema for Agent-editable trim decisions. Derived seams and verification are generated and validated only by scripts/trim-contract.mjs.",
  "type": "object",
  "required": ["source", "fps", "remove"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 2 },
    "source": { "type": "string", "minLength": 1, "pattern": "^(?!/).+" },
    "fps": { "type": "integer", "minimum": 1 },
    "remove": {
      "type": "array",
      "items": { "$ref": "#/$defs/editDecision" }
    },
    "trimProfile": { "type": "object" },
    "seams": {
      "type": "array",
      "items": { "type": "object" }
    },
    "verification": { "type": "object" }
  },
  "$defs": {
    "editDecision": {
      "type": "object",
      "required": [
        "startFrame",
        "endFrame",
        "classification",
        "reason",
        "semanticEvidence",
        "confidence",
        "audioTransitionFrames"
      ],
      "additionalProperties": false,
      "properties": {
        "startFrame": { "type": "integer", "minimum": 0 },
        "endFrame": { "type": "integer", "minimum": 1 },
        "classification": {
          "enum": [
            "reading-reset",
            "false-start",
            "restart",
            "body-reset",
            "reset-removed",
            "duplicate-take",
            "natural-pause"
          ]
        },
        "reason": { "type": "string", "minLength": 1 },
        "semanticEvidence": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "audioTransitionFrames": { "type": "integer", "minimum": 0, "maximum": 2 },
        "diagnostic": {
          "type": "object",
          "required": ["path", "finding"],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^checkpoints/diagnostics/.+\\.json$"
            },
            "finding": { "type": "string", "minLength": 8 }
          }
        }
      }
    }
  }
}
