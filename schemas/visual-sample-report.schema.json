{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["passed", "checkedAt", "artifact", "source", "creativePackageSha256", "checks", "snapshotReviews"],
  "properties": {
    "$schema": { "type": "string" },
    "passed": { "type": "boolean" },
    "checkedAt": { "type": "string" },
    "artifact": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "creativePackageSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "snapshotReviews": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "status", "findings"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "status": { "enum": ["pass", "fail"] },
          "findings": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "pass" } } },
            "then": { "properties": { "findings": { "maxItems": 0 } } },
            "else": { "properties": { "findings": { "minItems": 1 } } }
          }
        ],
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "status": { "const": "pass" },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["path", "sha256"],
              "properties": {
                "path": { "type": "string" },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
