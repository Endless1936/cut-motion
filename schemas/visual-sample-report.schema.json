{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["passed", "checkedAt", "artifact", "source", "creativePackageSha256", "checks"],
  "properties": {
    "$schema": { "type": "string" },
    "passed": { "type": "boolean" },
    "checkedAt": { "type": "string" },
    "artifact": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "creativePackageSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "status": { "const": "pass" },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["kind", "path", "sha256", "subjectSha256", "bundleSha256", "validator", "validatorVersion", "runnerSha256", "command"],
              "properties": {
                "kind": { "enum": ["validator-report", "snapshot-manifest", "audio-analysis"] },
                "path": { "type": "string" },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "subjectSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "bundleSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "validator": { "type": "string", "minLength": 1 },
                "validatorVersion": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "runnerSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "command": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
