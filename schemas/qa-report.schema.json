{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cut-motion QA Report",
  "type": "object",
  "required": ["passed", "checkedAt", "artifacts", "checks"],
  "properties": {
    "$schema": { "type": "string" },
    "passed": { "type": "boolean" },
    "checkedAt": { "type": "string", "format": "date-time" },
    "artifacts": {
      "type": "object",
      "required": ["composition", "preview"],
      "properties": {
        "composition": { "$ref": "#/$defs/artifact" },
        "preview": { "$ref": "#/$defs/artifact" }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "status": { "enum": ["pass", "fail", "warning"] },
          "details": { "type": "string" },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["path", "sha256"],
              "properties": {
                "path": { "type": "string" },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
