{
  "name": "cut-motion-hyperframes-job",
  "private": true,
  "scripts": {
    "prepare:assets": "cp node_modules/gsap/dist/gsap.min.js assets/gsap.min.js",
    "lint": "hyperframes lint",
    "check": "hyperframes check",
    "preview": "hyperframes preview",
    "render:preview": "hyperframes render --quality standard --output ../previews/final-preview.mp4",
    "render": "hyperframes render --quality high --output ../output/final.mp4"
  },
  "devDependencies": {
    "gsap": "3.13.0",
    "hyperframes": "0.7.60"
  }
}
